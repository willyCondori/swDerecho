# Copiar como .env.docker o ejecutar: python scripts/preparar_docker.py
SECRET_KEY=CAMBIAR
ENCRYPTION_KEY=CAMBIAR_POR_64_CARACTERES_HEXADECIMALES
DB_NAME=bd_derecho
DB_USER=postgres
DB_PASSWORD=CAMBIAR
WEB_PORT=8080
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
FRONTEND_URL=http://localhost:8080
DEBUG=False
# HTTP local. Usar True al instalar detrás de HTTPS.
COOKIE_SECURE=False
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MODEL_VERSION=e5_base
LECTURA_NORMATIVA_MOTOR=clasico
OLLAMA_NORMATIVO_MODELO=qwen3.5:2b
OLLAMA_NORMATIVO_CONTEXTO=4096
OLLAMA_NORMATIVO_TIMEOUT=180
OLLAMA_NORMATIVO_KEEP_ALIVE=5m
# Opcional: SMTP para creación/recuperación de cuentas.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
TSJ_API_KEY=
TSJ_API_USERNAME=buscadorgenesis
JURISPRUDENCIA_TOP_N=5
JURISPRUDENCIA_UMBRAL=0.65
